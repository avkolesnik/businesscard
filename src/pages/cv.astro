---
import TgIcon from '../components/tgicon.astro';
// src/pages/cv.astro
const name = "Александр Колесник";
const role = "Системный аналитик";
const email = "kolesnik.al.vi@gmail.com";
const telegram = "@avkolesnik"; 
const location = "г. Москва";
const githubLink = "https://github.com/avkolesnik/";
const portfoliosite = "https://avkolesnik.github.io/businesscard"

// Данные опыта (вынесены сюда для удобства редактирования)
const experience = [
    {
        company: "Пост Модерн Текнолоджи",
        project: "МИС (Медицинская информационная система)",
        period: "Окт 2024 — Сен 2026",
        role: "Системный аналитик",
        achievements: [
            "Спроектировал модуль «Кадровая система»: от сбора требований до модели данных и постановки задач.",
            "Реализовал единую систему коммуникаций (E-mail, SMS, WebSocket) с поддержкой шаблонов и очередей доставки.",
            "Интегрировал электронную подпись (ЭП) и авторизацию через Keycloak (SSO/RBAC).",
            "Провел реверс-инжиниринг legacy-решений, обеспечил бесшовную миграцию логики."
        ]
    },
    {
        company: "WeMakeTeam",
        project: "ITSM-система",
        period: "Дек 2023 — Окт 2024",
        role: "Системный аналитик",
        achievements: [
            "Спроектировал сложный блок «Графики работы» (учет федеральных/региональных праздников, смены).",
            "Разработал «Личный кабинет сотрудника»: UX/UI согласование, модель данных, User Stories.",
            "Внедрил Living Documentation в Confluence, сократив время онбординга новых участников команды.",
            "Сопровождал вывод решения в промышленную эксплуатацию (post-release support)."
        ]
    },
    {
        company: "РСХБ-Интех",
        project: "DWH & Аналитическая отчетность",
        period: "Янв 2022 — Дек 2023",
        role: "Системный аналитик",
        achievements: [
            "Транслировал бизнес-метрики в технические спецификации для SQL-разработчиков витрин данных.",
            "Оптимизировал запросы к источникам, снизив время формирования критических отчетов.",
            "Разрабатывал тест-кейсы и ПМИ, проводил приемочное тестирование (PSI) совместно с бизнесом."
        ]
    },
    {
        company: "Банковский сектор (Уралсиб, UniCredit)",
        project: "Системы мотивации и планирования целей",
        period: "Ноя 2019 — Янв 2022",
        role: "Главный эксперт / Системный аналитик",
        achievements: [
            "Проектировал доменную модель системы KPI: справочники, формулы расчета, правила валидации.",
            "Моделировал процессы AS-IS/TO-BE (BPMN/UML), выявлял узкие места в расчетах бонусов.",
            "Формировал требования к BI-дашбордам и прогнозным моделям розничного бизнеса."
        ]
    }
];
---

<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <title>{name} | CV</title>
    <style is:global>
    :root {
        /* Цвета из основного лендинга */
        --bg-dark: #111827;       /* gray-900 */
        --text-light: #f3f4f6;    /* gray-100 */
        --text-muted: #9ca3af;    /* gray-400 */
        --accent-blue: #60a5fa;   /* blue-400 */
        --accent-emerald: #34d399;/* emerald-400 */
        --card-bg: rgba(31, 41, 55, 0.5); /* gray-800/50 */
        --border-color: #374151;  /* gray-700 */
        
        /* Для печати переопределим позже */
        --print-text: #000;
        --print-bg: #fff;
    }

    body {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.6;
        color: var(--text-light);
        background-color: var(--bg-dark);
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 850px;
        margin: 40px auto;
        padding: 0 20px;
    }

    header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    h1 {
        font-size: 2rem;
        margin: 0 0 5px 0;
        /* Градиент как в заголовке лендинга */
        background: linear-gradient(to right, var(--accent-blue), var(--accent-emerald));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: inline-block;
    }

    .subtitle {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-bottom: 15px;
    }

    .contact-info {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        font-size: 0.9rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 5px;
        color: var(--text-muted);
    }

    a {
        color: var(--accent-blue);
        text-decoration: none;
        transition: color 0.2s;
    }

    a:hover {
        color: var(--accent-emerald);
        text-decoration: underline;
    }

    section {
        margin-bottom: 25px;
    }

    h2 {
        font-size: 1.3rem;
        color: var(--text-light);
        border-left: 4px solid var(--accent-blue);
        padding-left: 10px;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Summary Block */
    .summary p {
        margin: 0 0 10px 0;
        font-size: 1rem;
        color: var(--text-light);
    }

    /* Skills Grid */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .skill-category {
        background-color: var(--card-bg);
        padding: 15px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .skill-category h3 {
        font-size: 1rem;
        margin: 0 0 10px 0;
        color: var(--accent-emerald);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 5px;
    }

    .skill-tags {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .skill-tags li {
        display: inline-block;
        margin-right: 8px;
        margin-bottom: 4px;
    }

    /* Experience Cards */
    .job-card {
        margin-bottom: 20px;
        page-break-inside: avoid;
        background-color: var(--card-bg);
        padding: 15px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .job-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        margin-bottom: 5px;
    }

    .company-name {
        font-weight: bold;
        font-size: 1.1rem;
        color: var(--text-light);
    }

    .date-range {
        color: var(--text-muted);
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .project-role {
        font-style: italic;
        color: var(--accent-blue);
        font-size: 0.95rem;
        margin-bottom: 8px;
    }

    .achievements-list {
        padding-left: 20px;
        margin: 0;
        font-size: 0.95rem;
        color: var(--text-light);
    }

    .achievements-list li {
        margin-bottom: 4px;
    }

    /* Education & Courses */
    .edu-item {
        margin-bottom: 10px;
        padding-left: 10px;
        border-left: 2px solid var(--border-color);
    }
    
    .edu-title {
        font-weight: bold;
        color: var(--text-light);
    }
    
    .edu-sub {
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    /* Download Button */
    .download-btn-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 100;
    }
    
    .btn-download {
        background: linear-gradient(to right, var(--accent-blue), var(--accent-emerald));
        color: white;
        padding: 12px 24px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: bold;
        box-shadow: 0 4px 15px rgba(96, 165, 250, 0.3);
        cursor: pointer;
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
        font-size: 1rem;
    }
    
    .btn-download:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(96, 165, 250, 0.4);
    }

    /* =========================================
       PRINT STYLES (PDF Export) 
       Здесь возвращаем всё к черно-белому виду
       ========================================= */
    @media print {
        body {
            background-color: white !important;
            color: black !important;
            margin: 0;
            padding: 1cm;
            font-size: 10pt;
        }
        
        .container {
            max-width: 100%;
            margin: 0;
            padding: 0;
        }

        h1 {
            background: none !important;
            color: black !important;
            -webkit-text-fill-color: black !important;
            font-size: 1.8rem;
            border-bottom: 1px solid #ccc;
        }

        .subtitle {
            color: #555 !important;
        }

        h2 {
            color: black !important;
            border-left-color: #333 !important;
        }

        .contact-item, .contact-info {
            color: #333 !important;
        }

        a {
            color: #000 !important;
            text-decoration: none !important;
        }

        /* Убираем фоны карточек и скругления */
        .job-card, .skill-category, .edu-item {
            background: none !important;
            border: none !important;
            padding: 0 !important;
            margin-bottom: 15px !important;
            box-shadow: none !important;
        }

        .skill-category h3 {
            color: black !important;
            border-bottom: 1px dotted #999 !important;
        }

        .project-role {
            color: #444 !important;
        }

        .achievements-list {
            color: black !important;
        }

        .download-btn-container {
            display: none !important;
        }
        
        /* Гарантируем разрыв страниц по логике блоков */
        .job-card {
            page-break-inside: avoid;
        }
    }
</style>
</head>
<body>

<div class="container">

    <!-- HEADER -->
    <header>
        <h1>{name}</h1>
        <div class="subtitle">{role}</div>
        
        <div class="contact-info">
            <div class="contact-item">📍 {location}</div>
            <div class="contact-item">✉️ <a href="mailto:{email}">{email}</a></div>
            <div class="contact-item"><TgIcon />
                <a href="https://t.me/{telegram.replace('@','')}" target="_blank">{telegram}</a>
            </div>
            <div class="contact-item">💻 <a href={githubLink} target="_blank">GitHub</a></div>
            <div class="contact-item">🌐 <a href={portfoliosite} target="_blank">Portfolio Site</a></div>
        </div>
    </header>

    <!-- SUMMARY -->
    <section class="summary">
        <h2>О себе</h2>
        <p>
            Системный аналитик с опытом более 6 лет в проектировании высоконагруженных распределенных систем и интеграционных решений (FinTech, MedTech). 
            Специализируюсь на микросервисной архитектуре, REST/gRPC API design и моделировании данных (PostgreSQL).
        </p>
        <br/>
        <p>
            Ключевые компетенции: полный цикл анализа (от сбора требований до PSI), разработка технической документации (OpenAPI, UML/BPMN), 
            глубокая экспертиза в интеграциях (Kafka, ESB, WebSockets) и управление доступом (OAuth2, Keycloak). 
            Английский B2. Готов к работе в международных продуктах.
        </p>
    </section>

    <!-- SKILLS -->
    <section>
        <h2>Технические навыки</h2>
        <div class="skills-grid">
            <div class="skill-category">
                <h3>Analysis & Modeling</h3>
                <ul class="skill-tags">
                    <li>UML (Class, Sequence)</li>
                    <li>BPMN 2.0</li>
                    <li>C4 Model</li>
                    <li>PlantUML / Draw.io</li>
                    <li>User Stories / Use Cases</li>
                </ul>
            </div>
            <div class="skill-category">
                <h3>API & Integration</h3>
                <ul class="skill-tags">
                    <li>RESTful API Design</li>
                    <li>OpenAPI (Swagger)</li>
                    <li>gRPC / SOAP</li>
                    <li>Kafka / RabbitMQ</li>
                    <li>WebSockets</li>
                </ul>
            </div>
            <div class="skill-category">
                <h3>Data & DB</h3>
                <ul class="skill-tags">
                    <li>PostgreSQL (ERD)</li>
                    <li>SQL (Complex Queries)</li>
                    <li>DWH Concepts</li>
                    <li>Redis</li>
                </ul>
            </div>
            <div class="skill-category">
                <h3>Tools & Process</h3>
                <ul class="skill-tags">
                    <li>Jira / Confluence</li>
                    <li>Git</li>
                    <li>Postman</li>
                    <li>Figma (Basic)</li>
                    <li>Agile / Scrum</li>
                </ul>
            </div>
             <div class="skill-category">
                <h3>Security & Dev Context</h3>
                <ul class="skill-tags">
                    <li>OAuth 2.0 / OIDC</li>
                    <li>Keycloak / RBAC</li>
                    <li>JavaScript (Scripting)</li>
                    <li>Python (Basics)</li>
                    <li>Low-code Platforms</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- EXPERIENCE -->
    <section>
        <h2>Опыт работы</h2>
        
        {experience.map(job => (
            <div class="job-card">
                <div class="job-header">
                    <span class="company-name">{job.company}</span>
                    <span class="date-range">{job.period}</span>
                </div>
                <div class="project-role">
                    {job.project} • {job.role}
                </div>
                <ul class="achievements-list">
                    {job.achievements.map(item => <li>{item}</li>)}
                </ul>
            </div>
        ))}
    </section>

    <!-- EDUCATION -->
    <section>
        <h2>Образование и курсы</h2>
        <div class="edu-item">
            <div class="edu-title">Программная инженерия. Разработка ПО</div>
            <div class="edu-sub">Университет Иннополис (2025)</div>
        </div>
        <div class="edu-item">
            <div class="edu-title">Высшее образование</div>
            <div class="edu-sub">ХГУЭП, Государственные и муниципальные финансы (2016)</div>
        </div>
         <div class="edu-item">
            <div class="edu-title">SQL Academy</div>
            <div class="edu-sub">Обучение SQL (2024)</div>
        </div>
    </section>

</div>

<!-- DOWNLOAD BUTTON -->
<div class="download-btn-container">
    <button onclick="window.print()" class="btn-download">
        ⬇ Скачать PDF
    </button>
</div>

</body>
</html>