---
// src/pages/index.astro
const name = "Александр Колесник"; 
const role = "System Analyst";
const tagline = "Превращаю хаос требований в четкую архитектуру.";
---

<style is:global>
  /* Базовые настройки для темной темы */
  body {
    background-color: #111827; /* gray-900 */
    color: #f3f4f6;            /* gray-100 */
    font-family: system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Хедер */
  header {
    padding: 1.5rem;
    border-bottom: 1px solid #1f2937; /* gray-800 */
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 64rem;
    width: 100%;
    margin: 0 auto;
  }

  .logo {
    font-weight: bold;
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  nav a {
    color: #9ca3af; /* gray-400 */
    text-decoration: none;
    margin-left: 1rem;
    transition: color 0.2s;
  }

  nav a:hover {
    color: white;
  }

  /* Основной контент */
  main {
    flex-grow: 1;
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
  }

  /* Hero секция */
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    background: linear-gradient(to right, #60a5fa, #34d399); /* blue-400 to emerald-400 */
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 3.75rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: #9ca3af; /* gray-400 */
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  /* Кнопки */
  .btn-primary {
    padding: 0.75rem 1.5rem;
    background-color: #2563eb; /* blue-600 */
    color: white;
    border-radius: 0.375rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.2);
    transition: background-color 0.2s;
  }

  .btn-primary:hover {
    background-color: #1d4ed8; /* blue-700 */
  }

  .btn-secondary {
    padding: 0.75rem 1.5rem;
    border: 1px solid #374151; /* gray-700 */
    color: #d1d5db; /* gray-300 */
    border-radius: 0.375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    border-color: #6b7280; /* gray-500 */
    color: white;
  }

  /* Секции */
  section {
    margin-bottom: 5rem;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    border-left: 4px solid #3b82f6; /* blue-500 */
    padding-left: 1rem;
  }

  .case-title {
    border-left-color: #10b981; /* emerald-500 */
  }

  /* Карточки кейсов */
  article {
    background-color: rgba(31, 41, 55, 0.3); /* gray-800/30 */
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid #374151; /* gray-700 */
    margin-bottom: 1.5rem;
    transition: border-color 0.2s;
  }

  article:hover {
    border-color: #4b5563; /* gray-600 */
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 1rem;
  }

  .badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    background-color: rgba(6, 78, 59, 0.5); /* emerald-900/50 */
    color: #34d399; /* emerald-400 */
  }

  .tags span {
    font-size: 0.75rem;
    color: #6b7280; /* gray-500 */
    margin-right: 0.5rem;
  }

  /* Футер */
  footer {
    border-top: 1px solid #1f2937; /* gray-800 */
    padding: 3rem 1.5rem;
    margin-top: auto;
    text-align: center;
  }

  .social-links a {
    color: #d1d5db; /* gray-300 */
    text-decoration: none;
    margin: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-links a:hover {
    color: white;
  }
  
  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }
</style>

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{name} | {role}</title>
	</head>
	<body>
		
		<!-- Header -->
		<header>
			<div class="logo">{name}</div>
			<nav>
				<a href="#about">Обо мне</a>
				<a href="#cases">Кейсы</a>
				<a href="#contact">Контакты</a>
        <a href="https://avkolesnik.github.io/businesscard/cv/">Резюме</a>
			</nav>
		</header>

		<main>
			
			<!-- Hero Section -->
			<section style="margin-top: 2.5rem;">
				<h1>{tagline}</h1>
				<p class="subtitle">
					Специализируюсь на проектировании высоконагруженных систем, работе с Kafka, 
					микросервисной архитектурой и создании качественной технической документации.
				</p>
				<div style="display: flex; gap: 1rem;">
					<a href="#contact" class="btn-primary">Связаться</a>
					<a href="#" class="btn-secondary">Скачать CV</a>
				</div>
			</section>

			<!-- About Section -->
			<section id="about">
				<h2>Обо мне</h2>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
					<div>
						<p>Я объединяю глубокое понимание бизнес-процессов с техническими навыками разработки.</p>
						<p>Мой подход: <strong>"Сначала схема, потом код"</strong>. Я уверен, что хорошо спроектированная система экономит месяцы поддержки.</p>
						<ul style="list-style-type: disc; padding-left: 1.5rem; color: #9ca3af; margin-top: 1rem;">
							<li><span style="color: white; font-weight: 500;">Stack:</span> Python (FastAPI/Django), JavaScript/TypeScript, Java (Spring concepts)</li>
							<li><span style="color: white; font-weight: 500;">Tools:</span> Kafka, PostgreSQL, Redis, Docker, Kubernetes</li>
							<li><span style="color: white; font-weight: 500;">Soft Skills:</span> Тех. писательство, фасилитация встреч, декомпозиция задач</li>
						</ul>
					</div>
					<div style="background-color: rgba(31, 41, 55, 0.5); padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #374151;">
						<h3 style="font-weight: 600; margin-bottom: 0.5rem;">Почему со мной удобно?</h3>
						<p style="color: #9ca3af; font-size: 0.875rem;">
							Как человек, который писал документацию для сложных плагин-систем (ТК Медиалог), 
							я знаю, как важно дать разработчику четкий контракт. Мои спецификации понятны и неисполнимых ситуаций не оставляют.
						</p>
					</div>
				</div>
			</section>

			<!-- Cases Section -->
			<section id="cases">
				<h2 class="case-title">Избранные проекты</h2>
				
				<div>
					<!-- Case 1 -->
					<article>
						<div class="card-header">
							<h3 style="font-size: 1.25rem; font-weight: 700; color: white;">Smart Notification Dispatcher</h3>
							<span class="badge">Architecture & Logic</span>
						</div>
						<p style="color: #9ca3af; margin-bottom: 1rem;">
							Сервис для обработки 10k+ событий в минуту из Kafka. Реализована логика сравнения состояний (diff), 
							идемпотентность через PostgreSQL и механизм ретраев с DLQ.
						</p>
						<div class="tags">
							<span>#Kafka</span> <span>#PostgreSQL</span> <span>#Idempotency</span> <span>#EventDriven</span>
						</div>
					</article>

					<!-- Case 2 -->
					<article>
						<div class="card-header">
							<h3 style="font-size: 1.25rem; font-weight: 700; color: white;">Plugin Documentation System</h3>
							<span class="badge" style="background-color: rgba(30, 58, 138, 0.5); color: #60a5fa;">Tech Writing</span>
						</div>
						<p style="color: #9ca3af; margin-bottom: 1rem;">
							Разработка стандартов технической документации для экосистемы плагинов. 
							Внедрение OpenAPI спецификаций и автоматической генерации примеров кода.
						</p>
						<div class="tags">
							<span>#OpenAPI</span> <span>#Documentation</span> <span>#DX</span>
						</div>
					</article>
				</div>
			</section>

		</main>

		<!-- Footer -->
		<footer id="contact">
			<div style="max-width: 64rem; margin: 0 auto; padding: 0 1.5rem;">
				<h2 style="border:none; padding:0; margin-bottom: 1rem;">Готов обсудить ваш проект!</h2>
				<p style="color: #9ca3af; margin-bottom: 2rem;">Пишите напрямую в Telegram или почту. Отвечаю быстро.</p>
				
				<div class="social-links" style="display: flex; justify-content: center; gap: 2rem;">
					<a href="mailto:kolesnik.al.vi@gmail.com" style="color: #43fed6; text-decoration: none; display: inline-flex; align-items: center; gap: 0.75rem; font-size: 1.75rem; transition: color 0.2s;">
						<svg style="width: 2rem; height: 2rem; fill: currentColor;" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path></svg>
						Email
					</a>
					<a href="https://t.me/avkolesnik" target="_blank" style="color: #14d8ee; text-decoration: none; display: inline-flex; align-items: center; gap: 0.75rem; font-size: 1.75rem; transition: color 0.2s;">
						<svg style="width: 2rem; height: 2rem; fill: currentColor;" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.68c.223-.204-.05-.314-.344-.114l-6.4 4.02-2.76-.86c-.6-.19-.61-.6.13-.89l10.78-4.15c.5-.18.94.12.77.88z"/></svg>
						Telegram
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>